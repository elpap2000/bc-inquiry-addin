<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- ============================================================
       TOTOTHEO MARITIME - BC Inquiry Checker
       Outlook Add-in Manifest v1.1
       
       DEPLOYMENT: Upload this file in Microsoft 365 Admin Center
       Admin Center → Settings → Integrated Apps → Upload custom app
       ============================================================ -->

  <!-- IMPORTANT: Change this GUID if you deploy multiple versions -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Tototheo Maritime</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="BC Inquiry Checker"/>
  <Description DefaultValue="Search and open Business Central Inquiry List from any email. Detects RFQ references automatically."/>

  <!-- Icons - replace URLs with your hosted icon files -->
  <IconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://businesscentral.dynamics.com/Tototheo/"/>

  <AppDomains>
    <AppDomain>https://businesscentral.dynamics.com</AppDomain>
    <AppDomain>https://elpap2000.github.io/bc-inquiry-addin</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Fallback for older Outlook clients -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://elpap2000.github.io/bc-inquiry-addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <!-- Activate on ALL emails (read mode) -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides adds the ribbon button -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- The button that appears in Outlook ribbon -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image Size="16" resid="Icon.16x16"/>
                    <bt:Image Size="32" resid="Icon.32x32"/>
                    <bt:Image Size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <!-- Replace with your actual hosted icon URLs -->
        <bt:Image id="Icon.16x16" DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-samples/main/Assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://elpap2000.github.io/bc-inquiry-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Business Central"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="BC Inquiry Checker"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Search Business Central Inquiry List. Detects RFQ reference from email automatically."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
